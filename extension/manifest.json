{
  "manifest_version": 2,
  "name": "MCP Browser Bridge",
  "version": "0.2.4",
  "description": "Connect website tabs to local MCP with per-tab approval or optional automatic access.",
  "browser_specific_settings": {
    "gecko": {
      "id": "approved-tabs@drima-browser.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity", "personallyIdentifyingInfo", "personalCommunications", "locationInfo", "healthInfo", "financialAndPaymentInfo", "authenticationInfo", "searchTerms"]
      }
    }
  },
  "permissions": ["activeTab", "nativeMessaging", "storage"],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "MCP Browser Bridge: access controls", "default_popup": "popup.html"}
}
